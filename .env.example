TELEGRAM_BOT_TOKEN=123456789:your_telegram_bot_token
OPENAI_API_KEY=sk-your_openai_api_key

# Optional
OPENAI_MODEL=gpt-5.4-mini
SYSTEM_PROMPT=You are a helpful AI assistant inside Telegram. Reply clearly and concisely.
MAX_HISTORY_MESSAGES=12

# Optional private mode. Leave blank to allow anyone who finds the bot to use it.
# Put one or more Telegram user IDs separated by commas, e.g. 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=
